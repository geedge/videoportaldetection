<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">
<configuration>
    <properties resource="clickhouse.properties" />
    <!-- mybatis的配置环境 -->
    <environments default="development">
        <!-- mybatis的配置环境 -->
        <environment id="development">
            <!-- 事物管理配置 -->
            <transactionManager type="JDBC" />
            <!-- 数据源的选择 -->
            <dataSource type="POOLED">
                <!-- 数据库链接的配置 -->
                <property name="driver" value="${jdbc.driver}" />
                <property name="url" value="${jdbc.url}" />
                <property name="username" value="${jdbc.username}" />
                <property name="password" value="${jdbc.password}" />
            </dataSource>
        </environment>
    </environments>

    <mappers>
        <!--<mapper resource必须放在resource目录，而mapper class可以同目录同名扫描-->
        <mapper class="cn.ac.iie.mapper.SSLListMapper"/>
        <mapper class="cn.ac.iie.mapper.HTTPListMapper"/>
        <mapper class="cn.ac.iie.mapper.AVDataListMapper"/>
    </mappers>
</configuration>